# ===== Modo =====
APP_MODE=local                      # local | hosted
API_BASE_URL=                       # (frontend hospedado) URL pública do backend, ex.: https://api.seudominio.com
APP_ACCESS_TOKEN=                   # se definido, exige código de acesso (use na versão hospedada!)
CORS_ORIGINS=http://localhost:3000  # origens autorizadas (usado se o backend for acessado por outro domínio)

# ===== Banco de dados / fila =====
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
REDIS_URL=redis://localhost:6379    # reservado: escala horizontal com workers (a fila atual roda em processo, estado no PostgreSQL)
JOB_CONCURRENCY=2

# ===== Armazenamento =====
STORAGE_DIR=storage                 # disco/volume persistente (local ou volume Docker)
STORAGE_QUOTA_GB=50
# Driver S3 (reservado para expansão; ver README > Armazenamento)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ===== Limites e segurança =====
MAX_UPLOAD_MB=4096
MAX_IMPORT_MB=2048
MAX_VIDEO_MINUTES=240
TMP_TTL_HOURS=24
ALLOW_PRIVATE_URLS=false            # NUNCA habilite em produção (anti-SSRF)

# ===== Modelos de IA (locais) =====
WHISPER_MODEL=Xenova/whisper-base   # tiny | base | small (qualidade x velocidade em CPU)
WHISPER_LANGUAGE=pt
OLLAMA_URL=                         # ex.: http://localhost:11434 (opcional: resumos, chat, hooks, tradução)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=                # opcional (ex.: llava) — reservado
CV_SERVICE_URL=                     # ex.: http://localhost:8001 (detecção automática de webcam; ver /backend)

# ===== Binários (opcional) =====
FFMPEG_PATH=
FFPROBE_PATH=
